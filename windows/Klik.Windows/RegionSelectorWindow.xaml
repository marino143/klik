<Window x:Class="Klik.Windows.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#55000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Cursor="Cross" KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
  <Canvas x:Name="Surface">
    <Border x:Name="Selection" Visibility="Collapsed" BorderBrush="#E24A31" BorderThickness="2" Background="#18FFFFFF">
      <TextBlock x:Name="SizeLabel" VerticalAlignment="Top" HorizontalAlignment="Left"
                 Margin="6" Padding="6,3" Foreground="White" Background="#D9171717"
                 FontFamily="Segoe UI" FontSize="12" />
    </Border>
    <TextBlock Text="Drag to select a region. Esc cancels."
               Canvas.Left="24" Canvas.Top="24" Padding="10,7"
               Foreground="White" Background="#E6171717" FontFamily="Segoe UI" FontSize="14" />
  </Canvas>
</Window>
