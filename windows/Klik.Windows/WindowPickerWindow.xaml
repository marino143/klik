<Window x:Class="Klik.Windows.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a window" Width="520" Height="470" WindowStartupLocation="CenterOwner"
        Background="#FAFAFA" FontFamily="Segoe UI" KeyDown="OnKeyDown">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Choose a window" FontSize="22" FontWeight="SemiBold" Foreground="#171717" />
      <TextBlock Text="Only visible application windows are listed." Margin="0,5,0,0" Foreground="#676767" />
    </StackPanel>
    <ListBox x:Name="WindowList" Grid.Row="2" BorderBrush="#DADADA" BorderThickness="1"
             MouseDoubleClick="OnDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="8,6">
            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ProcessName}" FontSize="12" Foreground="#777777" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" MinWidth="88" Margin="0,0,8,0" Click="OnCancel" />
      <Button Content="Choose" MinWidth="88" Background="#E24A31" Foreground="White"
              BorderBrush="#E24A31" Click="OnChoose" />
    </StackPanel>
  </Grid>
</Window>
