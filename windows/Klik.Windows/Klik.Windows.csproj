<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Klik</AssemblyName>
    <RootNamespace>Klik.Windows</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Marino Glazar</Authors>
    <Description>Fast screen capture and recording for Windows 10.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.12" />
  </ItemGroup>
</Project>
