<Window x:Class="Klik.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klik" Width="470" Height="610" MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#FAFAFA" FontFamily="Segoe UI"
        Closing="OnClosing" SourceInitialized="OnSourceInitialized">
  <Grid>
    <Grid x:Name="ReadyView" Margin="26,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="28" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="30" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="30" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Klik" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
          <TextBlock Text="Screen capture for Windows 10" Margin="0,3,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="9" Background="#E24A31">
          <TextBlock Text="K" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="White" FontSize="22" FontWeight="Bold" />
        </Border>
      </Grid>

      <StackPanel Grid.Row="2">
        <TextBlock Text="SCREENSHOTS" FontSize="11" FontWeight="SemiBold" Foreground="#6B6B6B" />
        <UniformGrid Columns="3" Margin="0,10,0,0">
          <Button Content="Region" Margin="0,0,7,0" Click="CaptureRegion_Click" ToolTip="Win+Shift+2" />
          <Button Content="Screen" Margin="0,0,7,0" Click="CaptureScreen_Click" ToolTip="Win+Shift+3" />
          <Button Content="Window" Click="CaptureWindow_Click" ToolTip="Win+Shift+4" />
        </UniformGrid>
      </StackPanel>

      <StackPanel Grid.Row="4">
        <TextBlock Text="VIDEO" FontSize="11" FontWeight="SemiBold" Foreground="#6B6B6B" />
        <UniformGrid Columns="3" Margin="0,10,0,0">
          <Button Content="Region" Margin="0,0,7,0" Click="RecordRegion_Click" />
          <Button Content="Screen" Margin="0,0,7,0" Click="RecordScreen_Click" ToolTip="Win+Shift+5" />
          <Button Content="Window" Click="RecordWindow_Click" />
        </UniformGrid>
      </StackPanel>

      <StackPanel Grid.Row="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="RECORDING AUDIO" FontSize="11" FontWeight="SemiBold" Foreground="#6B6B6B" VerticalAlignment="Center" />
          <CheckBox x:Name="MicrophoneCheck" Grid.Column="1" Content="Microphone" IsChecked="True"
                    VerticalAlignment="Center" Foreground="#333333" />
        </Grid>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button x:Name="SpeakersButton" Content="Speakers" Margin="0,0,5,0" Click="Speakers_Click"
                  Background="#171717" Foreground="White" BorderBrush="#171717" />
          <Button x:Name="HeadphonesButton" Grid.Column="1" Content="Headphones" Margin="5,0,0,0" Click="Headphones_Click" />
        </Grid>
        <TextBlock x:Name="AudioModeHelp" Text="For recordings played through speakers."
                   Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" />
      </StackPanel>

      <StackPanel Grid.Row="8">
        <Separator Background="{StaticResource LineBrush}" Margin="0,0,0,15" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Save to" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            <TextBlock x:Name="OutputFolderText" Margin="0,2,12,0" TextTrimming="CharacterEllipsis" FontSize="13" />
          </StackPanel>
          <Button Grid.Column="1" Content="Change" Padding="12,7" Click="ChangeFolder_Click" />
        </Grid>
        <TextBlock x:Name="StatusText" Margin="0,13,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="Ready" />
      </StackPanel>
    </Grid>

    <Grid x:Name="RecordingView" Visibility="Collapsed" Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="340">
        <Ellipse Width="12" Height="12" Fill="#E24A31" HorizontalAlignment="Center" />
        <TextBlock Text="Recording" Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="16" Foreground="{StaticResource MutedBrush}" />
        <TextBlock x:Name="TimerText" Text="00:00" Margin="0,4,0,26" HorizontalAlignment="Center"
                   FontSize="44" FontWeight="SemiBold" />
        <UniformGrid Columns="3">
          <Button x:Name="PauseButton" Content="Pause" Margin="0,0,7,0" Click="Pause_Click" />
          <Button Content="Stop" Margin="0,0,7,0" Background="#E24A31" Foreground="White"
                  BorderBrush="#E24A31" Click="Stop_Click" />
          <Button Content="Cancel" Click="CancelRecording_Click" />
        </UniformGrid>
        <TextBlock Text="Win+Shift+5 opens Klik" HorizontalAlignment="Center" Margin="0,18,0,0"
                   Foreground="{StaticResource MutedBrush}" FontSize="12" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
