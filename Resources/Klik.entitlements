<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime blocks microphone input unless the app asks for
         it here. Screen capture needs no entitlement — ScreenCaptureKit is
         gated by TCC, which the usage strings in Info.plist cover. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
